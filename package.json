{
	"name": "@stickerdaniel/convex-autumn-svelte",
	"author": "Daniel Sticker",
	"version": "0.4.0",
	"description": "Svelte 5 wrapper for Convex Autumn billing - reactive, type-safe, SSR-ready",
	"license": "MIT",
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"convex",
		"autumn",
		"billing",
		"stripe",
		"payments",
		"subscription",
		"saas"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stickerdaniel/convex-autumn-svelte.git"
	},
	"homepage": "https://github.com/stickerdaniel/convex-autumn-svelte#readme",
	"bugs": {
		"url": "https://github.com/stickerdaniel/convex-autumn-svelte/issues"
	},
	"type": "module",
	"svelte": "./dist/svelte/index.svelte.js",
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/svelte",
		"dist/sveltekit",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/convex",
		"!dist/demo",
		"src/lib/svelte",
		"src/lib/sveltekit",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev:frontend": "vite dev",
		"dev:backend": "bunx convex dev",
		"dev": "concurrently --kill-others --prefix-colors blue,yellow --names 'svelte,convex' 'bun dev:frontend' 'bun dev:backend'",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --no-tsconfig --ignore \"src/lib/convex,dist\"",
		"check:watch": "svelte-kit sync && svelte-check --no-tsconfig --ignore \"src/lib/convex,dist\" --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:e2e": "playwright test",
		"test:e2e:smoke": "playwright test --grep @smoke",
		"test": "bun run test:contracts && bun run test:unit",
		"test:contracts": "tsc --noEmit -p tsconfig.contracts.json && vitest run tests/contracts",
		"test:unit": "vitest run tests/unit"
	},
	"exports": {
		".": {
			"types": "./dist/svelte/index.svelte.d.ts",
			"svelte": "./dist/svelte/index.svelte.js",
			"default": "./dist/svelte/index.svelte.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.svelte.d.ts",
			"svelte": "./dist/svelte/index.svelte.js",
			"default": "./dist/svelte/index.svelte.js"
		},
		"./sveltekit": {
			"types": "./dist/sveltekit/index.d.ts",
			"svelte": "./dist/sveltekit/index.js",
			"default": "./dist/sveltekit/index.js"
		},
		"./sveltekit/server": {
			"types": "./dist/sveltekit/server/index.d.ts",
			"import": "./dist/sveltekit/server/index.js"
		}
	},
	"devDependencies": {
		"@convex-dev/auth": "0.0.95",
		"@mmailaender/convex-auth-svelte": "0.1.3",
		"@playwright/test": "1.62.1",
		"@skeletonlabs/skeleton": "4.15.2",
		"@skeletonlabs/skeleton-svelte": "4.15.2",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/package": "2.5.8",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "25.9.5",
		"concurrently": "9.2.4",
		"convex": "1.45.0",
		"convex-svelte": "0.14.0",
		"dotenv": "17.4.2",
		"jose": "6.2.10",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "3.5.2",
		"prettier-plugin-tailwindcss": "0.8.1",
		"publint": "0.3.24",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"vite": "7.3.6",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.21.0",
		"convex": "^1.24.3",
		"convex-svelte": ">=0.13.0",
		"svelte": "^5.38.5"
	},
	"dependencies": {
		"@useautumn/convex": "^0.0.23",
		"atmn": "^0.0.36",
		"autumn-js": "^0.1.82",
		"cookie": "^1.0.2",
		"is-network-error": "^1.1.0",
		"jwt-decode": "^4.0.0",
		"path-to-regexp": "^8.2.0"
	}
}
