{
	// The app and backend checks do not include tests. Check these public API
	// contracts separately because Vitest strips types while transforming.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false
	},
	"include": ["tests/contracts/**/*.ts", "src/lib/svelte/**/*.ts", "src/lib/sveltekit/**/*.ts"]
}
