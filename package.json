{
	"name": "@stickerdaniel/convex-autumn-svelte",
	"author": "Daniel Sticker",
	"version": "0.5.0",
	"description": "Svelte 5 wrapper for Convex Autumn billing - reactive, type-safe, SSR-ready",
	"license": "MIT",
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"convex",
		"autumn",
		"billing",
		"stripe",
		"payments",
		"subscription",
		"saas"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stickerdaniel/convex-autumn-svelte.git"
	},
	"homepage": "https://github.com/stickerdaniel/convex-autumn-svelte#readme",
	"bugs": {
		"url": "https://github.com/stickerdaniel/convex-autumn-svelte/issues"
	},
	"type": "module",
	"svelte": "./dist/svelte/index.svelte.js",
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/svelte",
		"dist/sveltekit",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/convex",
		"!dist/demo",
		"src/lib/svelte",
		"src/lib/sveltekit",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css",
		"./dist/sveltekit/server/index.js",
		"./src/lib/sveltekit/server/index.ts"
	],
	"scripts": {
		"dev:frontend": "vite dev",
		"dev:backend": "bunx convex dev",
		"dev": "concurrently --kill-others --prefix-colors blue,yellow --names 'svelte,convex' 'bun dev:frontend' 'bun dev:backend'",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-kit sync && svelte-package -i src/lib/svelte -o dist/svelte && svelte-package -i src/lib/sveltekit -o dist/sveltekit && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run check:backend",
		"check:backend": "tsc --noEmit -p src/lib/convex/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:e2e": "playwright test",
		"test:e2e:smoke": "playwright test --grep @smoke",
		"test": "bun run test:contracts && bun run test:unit",
		"test:contracts": "tsc --noEmit -p tsconfig.contracts.json && vitest run tests/contracts",
		"test:unit": "vitest run tests/unit",
		"test:compat": "bun run package && node scripts/check-consumers.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/svelte/index.svelte.d.ts",
			"svelte": "./dist/svelte/index.svelte.js",
			"default": "./dist/svelte/index.svelte.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.svelte.d.ts",
			"svelte": "./dist/svelte/index.svelte.js",
			"default": "./dist/svelte/index.svelte.js"
		},
		"./sveltekit": {
			"types": "./dist/sveltekit/index.d.ts",
			"svelte": "./dist/sveltekit/index.js",
			"default": "./dist/sveltekit/index.js"
		},
		"./sveltekit/server": {
			"types": "./dist/sveltekit/server/index.d.ts",
			"import": "./dist/sveltekit/server/index.js"
		}
	},
	"devDependencies": {
		"@convex-dev/auth": "0.0.90",
		"@mmailaender/convex-auth-svelte": "0.1.4",
		"@playwright/test": "1.58.2",
		"@skeletonlabs/skeleton": "4.13.0",
		"@skeletonlabs/skeleton-svelte": "4.13.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/package": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.19",
		"@tailwindcss/vite": "4.2.2",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "5.3.1",
		"@types/node": "25.5.0",
		"concurrently": "9.2.1",
		"convex": "1.33.1",
		"convex-svelte": "0.14.0",
		"dotenv": "17.3.1",
		"jose": "6.2.2",
		"prettier": "3.8.1",
		"prettier-plugin-svelte": "3.5.1",
		"prettier-plugin-tailwindcss": "0.7.2",
		"publint": "0.3.18",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.2.2",
		"typescript": "6.0.3",
		"vite": "8.3.2",
		"vitest": "4.1.0",
		"svelte-preprocess-import-assets": "1.1.0"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.21.0 || ^3.0.0",
		"convex": "^1.24.3",
		"convex-svelte": ">=0.13.0",
		"svelte": "^5.38.5"
	},
	"dependencies": {
		"@useautumn/convex": "^0.0.23",
		"atmn": "^0.0.36",
		"autumn-js": "^0.1.82",
		"cookie": "^1.1.1",
		"is-network-error": "^1.3.2",
		"jwt-decode": "^4.0.0",
		"path-to-regexp": "^8.4.2"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"vite": "8.3.2"
	}
}
